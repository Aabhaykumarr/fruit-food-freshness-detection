# Fruit & Food Freshness Detection System — Environment Variables Template
# Copy this file to .env and set your API keys.
# NEVER commit your actual .env file to version control.

# Google Gemini API Key (Primary Vision & Multimodal Reasoning)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_VISION_MODEL="gemini-3.5-flash-lite"

# Primary Vision Backend: "gemini" (recommended), "multimodal_openai", or "siglip" (offline fallback)
VISION_PRIMARY_BACKEND="gemini"

# Optional Secondary Provider: OpenAI Vision Model
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"

# Fallback Local Vision Model (Hugging Face)
VISION_MODEL_NAME="google/siglip-base-patch16-224"

# Web Application Settings
WEB_HOST="0.0.0.0"
WEB_PORT="8501"

# Hardware / Serial Settings (auto-detects connected Arduino or falls back to mock)
SERIAL_PORT="auto"
BAUD_RATE="9600"
ARDUINO_CLI_PATH="auto"
AUTO_FLASH_ARDUINO="true"

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
